      }
    },
    "consoleOwnerSessionSecret": {
      "type": "securestring",
      "metadata": {
        "description": "Random secret used to sign console owner and employee sessions."
      }
    },
    "costApiScope": {
      "type": "string",
      "defaultValue": "[format('api://{0}/.default', parameters('audience'))]",
