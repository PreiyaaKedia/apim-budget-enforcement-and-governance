            }
          ],
          "registries": [
            {
              "server": "[reference(resourceId('Microsoft.ContainerRegistry/registries', variables('registryName')), '2023-07-01').loginServer]",
              "identity": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('pullIdentityName'))]"
            }
          ],
          "ingress": {
            "external": true,
            "targetPort": 8000,
            "transport": "auto",
            "allowInsecure": false
          }
        },
        "template": {
          "containers": [
            {
              "name": "console",
              "image": "[if(empty(parameters('consoleContainerImage')), format('{0}/{1}:{2}', reference(resourceId('Microsoft.ContainerRegistry/registries', variables('registryName')), '2023-07-01').loginServer, parameters('consoleImageRepository'), parameters('consoleImageTag')), parameters('consoleContainerImage'))]",
              "resources": {
                "cpu": "[json('0.25')]",
                "memory": "0.5Gi"
              },
              "env": [
                {
                  "name": "COST_ENFORCEMENT_URL",
                  "value": "[format('https://{0}.{1}', variables('appName'), reference(resourceId('Microsoft.App/managedEnvironments', variables('environmentName')), '2024-03-01').defaultDomain)]"
                },
                {
                  "name": "COST_ENFORCEMENT_SCOPE",
                  "value": "[parameters('costApiScope')]"
                },
                {
                  "name": "APPLICATION_INSIGHTS_RESOURCE_ID",
                  "value": "[parameters('applicationInsightsResourceId')]"
                },
                {
                  "name": "CONSOLE_AUTH_DISABLED",
                  "value": "false"
                },
                {
                  "name": "CONSOLE_ALLOWED_EMAIL_DOMAINS",
                  "value": "[join(parameters('consoleAllowedEmailDomains'), ',')]"
                },
                {
                  "name": "CONSOLE_OWNER_USERNAME",
                  "value": "[parameters('consoleOwnerUsername')]"
                },
                {
                  "name": "CONSOLE_OWNER_PASSWORD_HASH",
                  "secretRef": "console-owner-password-hash"
                },
                {
                  "name": "CONSOLE_OWNER_SESSION_SECRET",
                  "secretRef": "console-owner-session-secret"
                },
                {
                  "name": "CONSOLE_OWNER_COOKIE_SECURE",
                  "value": "true"
                },
                {
                  "name": "CONSOLE_ENTRA_CLIENT_ID",
                  "value": "[parameters('consoleClientId')]"
                },
                {
                  "name": "CONSOLE_ENTRA_TENANT_ID",
                  "value": "[parameters('tenantId')]"
                }
              ],
              "probes": [
                {
                  "type": "Liveness",
                  "httpGet": {
                    "path": "/health",
                    "port": 8000,
                    "scheme": "HTTP"
                  },
                  "initialDelaySeconds": 10,
                  "periodSeconds": 30
                },
                {
                  "type": "Readiness",
                  "httpGet": {
                    "path": "/health",
                    "port": 8000,
                    "scheme": "HTTP"
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 10
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": 0,
            "maxReplicas": 3,
            "rules": [
              {
                "name": "http",
                "http": {
                  "metadata": {
                    "concurrentRequests": "25"
                  }
                }
              }
            ]
          }
        }
      },
      "dependsOn": [
        "[extensionResourceId(resourceId('Microsoft.ContainerRegistry/registries', variables('registryName')), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.ContainerRegistry/registries', variables('registryName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('pullIdentityName')), variables('acrPullRoleDefinitionId')))]",
        "[resourceId('Microsoft.App/managedEnvironments', variables('environmentName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('pullIdentityName'))]",
        "[resourceId('Microsoft.ContainerRegistry/registries', variables('registryName'))]"
      ]
    },
    {
      "condition": "[parameters('deployConsole')]",
      "type": "Microsoft.App/containerApps/authConfigs",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}/{1}', parameters('consoleAppName'), 'current')]",
      "properties": {
        "platform": {
          "enabled": false
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/containerApps', parameters('consoleAppName'))]"
      ]
    },
    {
      "condition": "[parameters('deployContainerApp')]",
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[variables('appName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned, UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('pullIdentityName')))]": {}
        }
      },
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', variables('environmentName'))]",
        "workloadProfileName": "Consumption",
        "configuration": {
          "activeRevisionsMode": "Single",
          "registries": [
            {
              "server": "[reference(resourceId('Microsoft.ContainerRegistry/registries', variables('registryName')), '2023-07-01').loginServer]",
              "identity": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('pullIdentityName'))]"
            }
          ],
          "ingress": {
            "external": true,
            "targetPort": 8000,
            "transport": "auto",
            "allowInsecure": false
          }
        },
        "template": {
          "containers": [
            {
              "name": "api",
              "image": "[if(empty(parameters('containerImage')), format('{0}/{1}:{2}', reference(resourceId('Microsoft.ContainerRegistry/registries', variables('registryName')), '2023-07-01').loginServer, parameters('imageRepository'), parameters('imageTag')), parameters('containerImage'))]",
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1Gi"
              },
              "env": [
                {
                  "name": "COSMOS_ENDPOINT",
                  "value": "[reference(resourceId('Microsoft.DocumentDB/databaseAccounts', variables('cosmosName')), '2024-11-15').documentEndpoint]"
                },
                {
                  "name": "COSMOS_DATABASE",
                  "value": "cost-enforcement"
                },
                {
                  "name": "COSMOS_LEDGER_CONTAINER",
                  "value": "ledger"
                },
                {
                  "name": "COSMOS_PRICING_CONTAINER",
                  "value": "pricing"
                },
                {
                  "name": "MONTHLY_LIMIT_USD",
                  "value": "[parameters('monthlyLimitUsd')]"
                },
                {
                  "name": "TENANT_ID",
                  "value": "[parameters('tenantId')]"
                },
                {
                  "name": "AUDIENCE",
                  "value": "[parameters('audience')]"
                },
                {
                  "name": "ALLOWED_CLIENT_ID",
                  "value": "[parameters('apimManagedIdentityClientId')]"
                },
                {
                  "name": "ADMIN_ALLOWED_PRINCIPAL_ID",
                  "value": "[coalesce(tryGet(if(parameters('deployConsole'), reference(resourceId('Microsoft.App/containerApps', parameters('consoleAppName')), '2024-03-01', 'full'), null()), 'identity', 'principalId'), '')]"
                },
                {
                  "name": "ADMIN_REQUIRED_ROLE",
                  "value": "CostEnforcement.Admin"
                },
                {
                  "name": "ADMIN_AUTH_DISABLED",
                  "value": "[string(parameters('adminAuthDisabled'))]"
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 10,
