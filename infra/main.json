    },
    "consoleAppName": {
      "type": "string",
      "defaultValue": "[format('{0}-budget-console', parameters('namePrefix'))]",
      "metadata": {
        "description": "Name of the budget console Container App."
      }
    },
    "containerAppsEnvironmentName": {
      "type": "string",
      "defaultValue": "[format('{0}-vnet-env', parameters('namePrefix'))]",
